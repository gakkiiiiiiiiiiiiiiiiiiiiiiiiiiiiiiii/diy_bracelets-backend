PORT=3008
NODE_ENV=development
UPLOAD_DIR=./uploads

# 生产环境必填：只允许明确的 H5/管理端来源，多个来源以英文逗号分隔。
# 小程序原生请求通常不携带 Origin，不需要加入此列表。
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=false
# 经过单层反向代理时设为 1；不要设置为 true。
TRUST_PROXY=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# PostgreSQL（本地开发与 Docker 部署共用）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=diy_bracelets
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=3000

# 过程视频使用 H5 的 Three.js 渲染器逐帧输出，再由 ffmpeg 编码。
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
VIDEO_WEB_RENDER_URL=http://127.0.0.1:5173/#/pages/design/design
FFMPEG_PATH=ffmpeg

# 管理端搭配 Agent：仅调用本机已登录的 Codex CLI，不需要填写 API Key
CODEX_CLI_PATH=codex
CODEX_CLI_MODEL=
CODEX_CLI_PROFILE=
CODEX_CLI_TIMEOUT_MS=180000

# OpenAI：仅用于自动水晶识别、Imagegen 提取和向量生成
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 自动提取输入/产物目录与无同类参考时的规格默认价
EXTRACTION_SOURCE_DIR=../downloads/douyin-wufang-bracelets/carousel-originals
EXTRACTION_OUTPUT_DIR=./uploads/extractions
DEFAULT_CRYSTAL_PRICE_6MM=2
DEFAULT_CRYSTAL_PRICE_8MM=3
DEFAULT_CRYSTAL_PRICE_10MM=4
DEFAULT_CRYSTAL_PRICE_12MM=5
DEFAULT_CRYSTAL_PRICE_14MM=6
